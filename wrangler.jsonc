{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name must match the Worker connected in Cloudflare Workers Builds.
  "name": "ledgerfox",
  "main": "src/worker/entry.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ledgerfox",
      "database_id": "dc22c743-9ead-46c8-9c34-8609a73ca023",
      "migrations_dir": "migrations"
    }
  ],
  // Custom Domain: Cloudflare creates the DNS record and TLS certificate on deploy.
  // Requires niyazio.com to be an active zone in the same Cloudflare account.
  // foxlator.niyazio.com is the address. ledgerfox.niyazio.com (the original) stays attached: browsers there are sent
  // to foxlator (public/theme.js), while Razorpay webhooks and older installed apps keep working until they move.
  "routes": [{ "pattern": "foxlator.niyazio.com", "custom_domain": true }, { "pattern": "ledgerfox.niyazio.com", "custom_domain": true }],
  "observability": { "enabled": true },
  // Smart Placement (free): runs the Worker close to the D1 database instead of close to the visitor, because one
  // screen makes several database queries and each one would otherwise cross the world and back.
  "placement": { "mode": "smart" },
  // Daily at 03:17 UTC (08:47 IST): trial and renewal reminder emails (only when billing and email are switched on).
  "triggers": { "crons": ["17 3 * * *"] },
  // Keep variables added in the Cloudflare dashboard (e.g. VENDOR_ADMIN_EMAILS) when CI deploys; values below still win.
  "keep_vars": true,
  "vars": {
    "BRAND_NAME": "Foxlator",
    "APP_ENV": "production",
    "PBKDF2_ITERATIONS": "50000",
    "ALLOW_REGISTRATION": "true",
    "GITHUB_REPO": "Niyazio/ledgerfox",
    // Subscriptions on the hosted website (BILLING.md). Razorpay keys are Worker secrets, never in this file.
    "BILLING_ENABLED": "true",
    // Public address used in links inside emails.
    "APP_URL": "https://foxlator.niyazio.com",
    // Printed on subscription invoices (public business registration number).
    "VENDOR_UDYAM": "UDYAM-KR-11-0094729",
    // New organisations set up auto-pay (₹5 refundable check) to start the 30-day free trial.
    "BILLING_REQUIRE_AUTOPAY": "true"
  }
}
