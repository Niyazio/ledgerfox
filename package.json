{
  "name": "ledgerfox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LedgerFox — free, open-source double-entry accounting ERP for Cloudflare Workers + D1",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply ledgerfox --local",
    "db:migrate:remote": "wrangler d1 migrations apply ledgerfox --remote",
    "deploy": "wrangler d1 migrations apply ledgerfox --remote && wrangler deploy",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:e2e": "node scripts/e2e.mjs",
    "backup": "bash scripts/backup.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "miniflare": "^4.20260730.0",
    "playwright-core": "^1.60.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
